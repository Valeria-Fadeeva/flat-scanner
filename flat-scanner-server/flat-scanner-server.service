[Unit]
Description=Flat Scanner Core Engine (Kanonissa) — движок оцифровки книг
Documentation=file:///usr/share/doc/flat-scanner-server/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
# Бинарник устанавливается PKGBUILD в /usr/bin
ExecStart=/usr/bin/flat_scanner_server
# Конфигурация bind-адреса (host/port) — см. /etc/flat-scanner-server/config.toml
Environment=FLAT_SCANNER_CONFIG=/etc/flat-scanner-server/config.toml
# Каталог работы: kanonissa.db, calibration.json, split/
WorkingDirectory=/var/lib/flat-scanner
# Автоперезапуск при сбое (важно для hot-restart сессии)
Restart=on-failure
RestartSec=3
# Ограничение ресурсов
LimitNOFILE=65536
# Безопасность (опционально, для системного сервиса)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target